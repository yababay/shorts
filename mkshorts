#!/bin/bash
set -uo pipefail   # -e намеренно убран: read и ffmpeg могут возвращать ненулевой код

TODAY=$(date +%Y-%m-%d)
MAX_ATTEMPTS=3
TEXT_DELAY=3
MIC="alsa_input.usb-MUSIC-BOOST_Usb_Microphone-00.mono-fallback"

# --- Источник аудио (массив, чтобы корректно передавать аргументы) ---
case "$(uname -s)" in
    Linux*)  AUDIO_IN=(-f pulse -i "$MIC") ;;
    Darwin*) AUDIO_IN=(-f avfoundation -i ":0") ;;
    MINGW*|MSYS*|CYGWIN*)
        echo "Укажите свой вариант AUDIO_IN для Windows (dshow)." >&2
        exit 1 ;;
    *) echo "Неизвестная ОС" >&2; exit 1 ;;
esac

# ============================================================
# Обработка одной директории.
# Возвращает 0 — успешно или пропущено, 1 — ошибка.
# ============================================================
process_directory() {
    local dir="${1%/}"
    local img="" readme="$dir/README.md" titles="$dir/titles.png"
    local silent="$dir/video_silent.mp4"
    local audio="$dir/audio.mp3"
    local attempt ans

    if [[ ! -d "$dir" ]]; then
        echo "⚠  Нет директории: $dir" >&2
        return 1
    fi

    for ext in jpg jpeg png; do
        if [[ -f "$dir/picture.$ext" ]]; then
            img="$dir/picture.$ext"
            break
        fi
    done

    if [[ -z "$img" ]]; then
        echo "⚠  $dir: нет picture.jpg/png — пропускаю."
        return 0
    fi
    if [[ ! -f "$readme" ]]; then
        echo "⚠  $dir: нет README.md — пропускаю."
        return 0
    fi
    if [[ ! -f "$titles" ]]; then
        echo "⚠  $dir: нет titles.png — пропускаю."
        return 0
    fi

    echo
    echo "================================================"
    echo "📁 Обработка: $dir"
    echo "================================================"

    # --- 1. Тихое видео: картинка -> titles.png через TEXT_DELAY секунд ---
    # Пересобираем, если нет файла ИЛИ исходники новее готового видео.
    if [[ ! -f "$silent" || "$img" -nt "$silent" || "$titles" -nt "$silent" ]]; then
        echo "🎬 Создаю видео без звука (текст через ${TEXT_DELAY}с)..."
        ffmpeg -y -loglevel error \
            -loop 1 -framerate 30 -i "$img" \
            -loop 1 -framerate 30 -i "$titles" \
            -filter_complex "\
[0:v]scale=1080:1920:force_original_aspect_ratio=decrease,\
pad=1080:1920:(ow-iw)/2:(oh-ih)/2:black,setsar=1,format=rgb24[base];\
[1:v]scale=1080:1920,setsar=1,format=rgb24[titled];\
[base][titled]overlay=0:0:enable='gte(t,${TEXT_DELAY})'[v]" \
            -map "[v]" -r 30 -t 60 \
            -c:v libx264 -preset slow -crf 20 -tune stillimage \
            -pix_fmt yuv420p "$silent" \
            || { echo "❌ Не удалось создать видео" >&2; return 1; }
    else
        echo "🎬 Тихое видео актуально — переиспользую."
    fi

    # --- 2. Запись голоса с подтверждением ---
    read -r -p "⏳ Нажмите Enter, когда будете готовы говорить." ans || ans=n
    local audio_ok=0
    for ((attempt=1; attempt<=MAX_ATTEMPTS; attempt++)); do
        echo
        echo "🎤 Попытка $attempt/$MAX_ATTEMPTS."
        echo "Текст для озвучки:"
        echo "------------------------------------------------"
        cat "$readme"
        echo
        echo "------------------------------------------------"
        echo "   Говорите в микрофон. Для остановки нажмите 'q' в окне ffmpeg."

        rm -f "$dir/audio_temp.wav" "$audio"

        ffmpeg "${AUDIO_IN[@]}" -ac 2 -ar 44100 -loglevel error "$dir/audio_temp.wav"
        if [[ ! -s "$dir/audio_temp.wav" ]]; then
            echo "❌ Запись пуста или не удалась."
            continue
        fi

        ffmpeg -y -loglevel error -i "$dir/audio_temp.wav" -loglevel error \
            -c:a libmp3lame -b:a 192k "$audio" \
            || { echo "❌ Ошибка конвертации в MP3"; continue; }
        rm -f "$dir/audio_temp.wav"

        read -r -p "👂 Устраивает качество аудио? (y/n): " ans || ans=n
        case "$ans" in
            [yY]*) audio_ok=1; break ;;
            *)     echo "   Пробуем ещё."; rm -f "$audio" ;;
        esac
    done

    if [[ "$audio_ok" -ne 1 ]]; then
        echo "❌ $dir: лимит попыток исчерпан."
        return 1
    fi

    # --- 3. Финальная склейка ---
    echo "🎞  Собираю финальное видео..."
    ffmpeg -y -loglevel error \
        -i "$silent" -i "$audio" \
        -c:v copy -c:a copy -shortest \
        -movflags +faststart "$dir/short.mp4" \
        || { echo "❌ Не удалось склеить" >&2; return 1; }

    echo "✅ Готово: $dir/short.mp4"
    return 0
}

# ============================================================
# Точка входа
# ============================================================
if [[ $# -gt 0 ]]; then
    # --- Режим одной директории ---
    if [[ $# -gt 1 ]]; then
        echo "Использование: $0 [имя_директории]" >&2
        exit 1
    fi

    target="${1%/}"
    # Разрешаем и "2026-10-29", и "./2026-10-29", и полный путь
    if [[ "$target" != */* && ! -d "$target" && -d "./$target" ]]; then
        target="./$target"
    fi

    if [[ ! -d "$target" ]]; then
        echo "❌ Директория не найдена: $target" >&2
        exit 1
    fi

    process_directory "$target"
    exit $?
fi

# --- Пакетный режим ---
shopt -s nullglob
dirs=( [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] )
shopt -u nullglob

if [[ ${#dirs[@]} -eq 0 ]]; then
    echo "Директории с датами не найдены."
    exit 0
fi

for dir in "${dirs[@]}"; do
    [[ "$dir" < "$TODAY" ]] && continue      # прошлые даты — не трогаем
    [[ -f "$dir/audio.mp3" ]] && continue    # уже озвучено — пропускаем
    process_directory "$dir" || echo "⚠  Ошибка в $dir, продолжаю дальше."
done

echo
echo "🎉 Все обработано."

